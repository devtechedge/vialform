# VIALFORM environment (placeholders only; never commit real values).
# Demo mode runs on embedded Postgres (PGLite) and cannot order or invoice.
DEMO_MODE="true"

# Optional production Postgres (Neon or equivalent). When set, the app uses
# node-postgres instead of embedded PGLite. Use the pooled URI for the app and
# the direct/unpooled URI for migrations.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Absolute public origin (set to the Vercel production alias after first deploy).
APP_URL="http://localhost:3000"

# Server-only secrets. Generate strong values (>= 32 chars) for any deployment.
# Used to sign session/CSRF tokens and private file download URLs.
AUTH_SECRET="replace-with-a-strong-random-secret-at-least-32-chars"
FILE_SIGNING_SECRET="replace-with-a-strong-random-secret-at-least-32-chars"

# Must be exactly "1" to allow seeding a non-demo database. Refused in production
# demo mode. The seed script also refuses when DEMO_MODE is false without this.
ALLOW_PROD_SEED=""